<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_part" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:paddingHorizontal="3dp" android:importantForAccessibility="noHideDescendants">
    <ImageView android:id="@+id/part_ring" android:layout_width="match_parent" android:layout_height="56dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone"/>
    <TextView android:id="@+id/part_percent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
        android:textColor="@color/widget_ink" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"/>
    <TextView android:id="@+id/part_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="왼쪽" android:textSize="11sp" android:textColor="@color/widget_muted"
        android:gravity="center" android:includeFontPadding="false" android:paddingTop="3dp" android:maxLines="1"/>
</LinearLayout>
