<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:paddingHorizontal="16dp" android:paddingVertical="6dp"
    android:importantForAccessibility="yes">
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="에어팟 한눈에" android:textSize="13sp" android:textColor="@color/widget_ink" android:importantForAccessibility="no"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_parts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="horizontal" android:importantForAccessibility="noHideDescendants"/>
            <LinearLayout android:id="@+id/widget_refresh_space" android:layout_width="48dp" android:layout_height="1dp"
                android:visibility="gone" android:importantForAccessibility="noHideDescendants"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="왼쪽 —   오른쪽 —   케이스 —" android:textSize="11sp" android:textColor="@color/widget_muted" android:importantForAccessibility="no"
            android:includeFontPadding="false" android:paddingTop="5dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical"
        android:contentDescription="배터리 새로고침" android:scaleType="centerInside" android:padding="12dp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent"
        android:text="열기" android:textSize="14sp" android:textColor="@color/widget_ink" android:gravity="center" android:importantForAccessibility="no"
        android:includeFontPadding="false" android:visibility="gone"/>
</FrameLayout>
